FIREBASE_PROJECT_ID=myproduction-v2
FIREBASE_DATABASE_URL=https://myproduction-v2-default-rtdb.asia-southeast1.firebasedatabase.app
# Paste entire service account JSON into Render secret environment variable; NEVER commit it.
FIREBASE_SERVICE_ACCOUNT=
# Comma-separated exact browser origins (no trailing slash)
ALLOWED_ORIGINS=https://YOURNAME.github.io,http://localhost:5500
# Firebase Web API key (public project key, not service account key)
FIREBASE_WEB_API_KEY=
# 32+ byte randomly generated secret, store in Render only
PIN_PEPPER=
