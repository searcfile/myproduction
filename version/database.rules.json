{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": false
      }
    },

    "sites": {
      ".read": "auth != null && root.child('admins').child(auth.uid).child('active').val() === true",
      ".write": false
    },

    "presence": {
      "$uid": {
        ".read": "auth != null && root.child('admins').child(auth.uid).child('active').val() === true",
        ".write": "$uid === auth.uid && root.child('admins').child(auth.uid).child('active').val() === true"
      }
    },

    "siteData": {
      "$siteId": {
        ".read": "auth != null && root.child('admins').child(auth.uid).child('active').val() === true && root.child('admins').child(auth.uid).child('sites').child($siteId).val() === true",
        ".write": "auth != null && root.child('admins').child(auth.uid).child('active').val() === true && root.child('admins').child(auth.uid).child('sites').child($siteId).val() === true"
      }
    }
  }
}
